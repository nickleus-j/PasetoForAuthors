@using OpineHere.mvc.Resources;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Opine Here</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/OpineHere.mvc.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="tile-grid">
        <ul>
            <li>
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">@Resources.DefaultAppTitle</a>
            </li>
            <li>
                <img src="~/opineanonymous.svg"/> <br/>
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="AnnonymousPost">@Resources.AnonymousPost</a>
            </li>
            
            @if (Context.Items["IsAuthenticated"] is true)
            {
                <li class="nav-item">
                    <img src="~/opine.svg">
                    <br/>
                    <a class="nav-link text-dark" asp-area="" asp-controller="Write" asp-action="Create">@Resources.MakePost</a>
                </li>
                <li>
                    
                    <b>&#128100;</b> <br/>
                    <a  href="#" id="userDropdown" role="button" >
                        <span id="greeting"> @Context.Items["UserDisplayName"]</span>
                    </a>
                </li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-sign-out-alt"></i> @Resources.Logout
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li>
                    <b>&#128100;</b> <br/>
                    <a class="nav-link" href="/Account/Login">
                       Log in
                    </a>
                </li>
                <li>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                        &#x1F4CB; <br/> 
                        @Resources.Register
                    </a>
                </li>
            }
            
        </ul>
    </nav>
</header>
<div class="primary-content">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; @DateTime.UtcNow.Year - @Resources.DefaultAppTitle - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Resources.Privacy</a>
    </div>
</footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>