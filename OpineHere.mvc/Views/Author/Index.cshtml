@using OpineHere.mvc.Resources
@using OpineHere.mvc.Service
@model IEnumerable<OpineHere.mvc.Models.MarkdownPostDto>

<div class="text-center">
    <h1 class="display-4">@Resources.Bulletin</h1>
    <div id="AuthorName"></div>
</div>
<hr/>
<div class="row">
    @foreach (var post in Model)
    {
        <div class="card mb-4 bg-light col-md-6 col-lg-4">
            <div class="card-header">
                <a class="form-label fw-bold mb-3" asp-action="leer" asp-controller="Write" asp-route-id="@post.Id">@post.Title</a>
            </div>
            <div class="card-body">
                <a class="btn btn-outline-info btn-author" data-author="@post.UserId">@post.AuthorName</a>
                <div id="penNameSection" class="mt-3">
                    @Html.Raw(MarkdownService.MarkdownToHtml(post.RawContent))
                </div>
            </div>
        </div>
    }
</div>
@section Scripts
{
    <script src="../js/WebCaller.js"></script>
    <script>
        async function loadAuthor() {
            try {
                const userId = document.querySelector(".btn-author").getAttribute("data-author");
                const response = await fetch('Author/Profile/?authorId='+userId);

                if (response.ok) {
                    const htmlString = await response.text();
                    const targetElement = document.getElementById('AuthorName');
                    targetElement.innerHTML=htmlString;
                }
            } catch (error) {
                console.error('Error fetching HTML:', error);
            }
        }
        window.addEventListener('DOMContentLoaded', () => {
            loadAuthor();
        })
    </script>
}
