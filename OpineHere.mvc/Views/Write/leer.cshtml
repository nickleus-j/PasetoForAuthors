@using OpineHere.mvc.Service;
@model MarkdownPostDto

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
}
<div class="row">
    <div class="col-sm-10 article-header">
        <h2>@Model.Title</h2>
        @Html.ActionLink(
            Model.AuthorName,
            "Index",                                    // actionName
            "Author",                                                   // routeValues
            new {                                                     // htmlAttributes
                penName = Model.AuthorName
            },new {@class="btn btn-info"}
        )
    </div>
</div>

<div class="row">
    <div class="col-sm-10 markdown-container justify-content-end" id="content">
        @Html.Raw(MarkdownService.MarkdownToHtml(Model.RawContent))
    </div>
</div>
@section Scripts{
    
}
