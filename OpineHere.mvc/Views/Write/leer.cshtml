@using OpineHere.mvc.Service;
@model MarkdownPostDto

@{
    ViewBag.Title = Model.Title;
    Layout = "_Layout";
    DateTimeOffset utcDateTime = DateTimeOffset.UtcNow; 
}
<div class="row">
    <div class="col-sm-10 article-header">
        <h2>@Model.Title</h2>
        
        @Html.ActionLink(
            Model.AuthorName,
            "Index",                                    
            "Author",   
            new { 
                penName = Model.AuthorName
            },new {@class="btn btn-info"}
        )
        <sub class="local-datetime" data-utc="@Model.PostDate.ToString("o")">
            @Model.PostDate.ToString("g")
        </sub>
    </div>
</div>

<div class="row">
    <div class="col-sm-10 markdown-container justify-content-end" id="content">
        @Html.Raw(MarkdownService.MarkdownToHtml(Model.RawContent))
    </div>
</div>
@section Scripts{
    <script>
        document.querySelectorAll('.local-datetime').forEach(el => {
            const utcStr = el.getAttribute('data-utc');
            if (utcStr) {
                const date = new Date(utcStr);
                // .toLocaleString() automatically applies the user's browser culture and local time zone
                el.textContent = date.toLocaleString(undefined, {
                    dateStyle: 'short',
                    timeStyle: 'short'
                });
            }
        });
    </script>
}
