@using OpineHere.mvc.Resources
@using OpineHere.mvc.Service
@model IEnumerable<OpineHere.mvc.Models.MarkdownPostDto>
@{
    ViewData["Title"] = Resources.Bulletin;
}
<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
</div>
<div class="row cards-row">
    @foreach (var post in Model)
    {
        <div class="card mb-4 bg-light col-md-6 col-lg-4">
            <div class="card-header">
                <a class="form-label fw-bold mb-3" asp-action="leer" asp-controller="Write" asp-route-id="@post.Id">@post.Title</a>
            </div>
            <div class="card-body">
                @Html.ActionLink(
                    post.AuthorName,
                    "Index",       
                    "Author",  
                    new {   
                        penName = post.AuthorName
                    },new {@class="btn btn-info"}
                )
                <div id="penNameSection" class="mt-3">
                    @Html.Raw(MarkdownService.MarkdownToHtml(post.RawContent))
                </div>
            </div>
        </div>
    }
</div>
<div class="details">
    <sub>Page <span class="page-number">1</span></sub>
    <span class="article-count">@Model.Count()</span>
</div>
@section Scripts
{
    <script src="../js/WebCaller.js"></script>
    <script>
        function updateStats(currentPage) {
            let pageNumberElem=document.querySelector(".page-number");
            let articleCountElem=document.querySelector(".article-count");
            let cards=document.querySelectorAll(".card");
            pageNumberElem.innerText=(currentPage).toString();
            articleCountElem.innerText=(cards.length).toString();
        }
        async function loadNextArticles(pageNumber,size) {
            try {
                const response = await fetch(`/Home/Articles/?page=${pageNumber}&pageSize=${size}`);

                if (!response.ok) throw new Error('Failed to fetch data');

                const targetElement = document.querySelector(".cards-row");
                const html = await response.text();
                targetElement.insertAdjacentHTML('beforeend',html);
                updateStats(pageNumber);
                let cards=document.querySelectorAll(".card");
                if((pageNumber)*size === cards.length){
                    setTimeout(() => {loadNextArticles(pageNumber+1,10)}, 500);
                }
            } catch (error) {
                
            }
        }
        let articleCount=@Model.Count();
        if(articleCount>=10){
            setTimeout(() => {loadNextArticles(2,10)}, 300);
        }
        
    </script>
}