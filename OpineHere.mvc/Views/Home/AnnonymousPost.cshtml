@using OpineHere.mvc.Resources
@model OpineHere.Data.entity.MarkdownPost

@{
    ViewData["Title"] = @Resources.DraftPost;
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h2 class="mb-4">@Resources.DraftPost</h2>
            <hr />

            <form asp-action="AnnonymousPost" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* Title Section *@
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold"></label>
                    <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter a catchy title..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                @* Author Selection Logic *@
                <div class="card mb-4 bg-light">
                    <div class="card-body">
                        <label class="form-label fw-bold mb-3">@Resources.AuthorLabel</label>
                        <div id="penNameSection" class="mt-3">
                            <label asp-for="PenName" class="form-label"></label>
                            <input asp-for="PenName" class="form-control" placeholder="What should we call you?" />
                            <span asp-validation-for="PenName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                @* Content Section *@
                <div class="mb-4">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Content" class="form-label fw-bold">@Resources.MarkdownSupportLabel</label>
                    </div>
                    <textarea asp-for="Content" id="RawContent" class="form-control font-monospace" rows="16" placeholder="@Resources.WriteThoughts"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">@Resources.Cancel</a>
                    <a class="btn btn-secondary" onclick="preview()">@Resources.Preview</a>
                    <button type="submit" class="btn btn-primary px-5">@Resources.PublishPost</button>
                </div>
            </form>
        </div>
    </div>
    <div id="preview-panel">
        
    </div>
</div>
@section Scripts
{
    <script src="../js/WebCaller.js"></script>
    <script>
        async function loadContent() {
            try {
                const content = document.querySelector("#RawContent").value;
                const response = await fetch('/Write/preview/?markdownString='+content);

                if (response.ok) {
                    const htmlString = await response.text();
                    const targetElement = document.getElementById('preview-panel');
                    targetElement.innerHTML=htmlString;
                }
            } catch (error) {
                console.error('Error fetching HTML:', error);
            }
        }
        async function preview(){
            try {
                let wCaller=new WebCaller();
                const content = document.querySelector("#RawContent").value;
                await wCaller.get('/Write/preview/',{"markdownString":content}).then( function (result) {
                    const targetElement = document.getElementById('preview-panel');
                    targetElement.innerHTML= result.htmlString; 
                });
            } catch (error) {
                console.error('Error fetching HTML:', error);
            }
        }
    </script>
}
