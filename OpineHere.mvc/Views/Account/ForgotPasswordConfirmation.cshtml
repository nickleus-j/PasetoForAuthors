@using OpineHere.mvc.Resources
@{
    ViewData["Title"] = Resources.CheckEmail;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4 text-center">
                    <h2 class="mb-4">ViewData["Title"]</h2>
                    <div class="mb-4">
                        <i class="bi bi-envelope fs-1 text-primary"></i>
                    </div>
                    <p class="lead">
                        @Resources.ForgotPasswordAccountExistLabel
                    </p>
                    <p class="text-muted">
                        @Resources.CheckSpamFolder The link will expire in 2 hours.
                    </p>
                    <a asp-action="Login" class="btn btn-outline-primary mt-3">@Resources.BackLogin</a>
                </div>
            </div>
        </div>
    </div>
</div>